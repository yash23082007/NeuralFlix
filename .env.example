SECRET_KEY=replace-with-64-char-random-string
REDIS_URL=redis://localhost:6379/0

# External API Keys (MANDATORY if NEURALFLIX_DEMO_MODE=false)
TMDB_API_KEY=your_tmdb_key
OMDB_API_KEY=your_omdb_key
TRAKT_CLIENT_ID=your_trakt_client_id
TRAKT_CLIENT_SECRET=your_trakt_client_secret
WATCHMODE_API_KEY=your_watchmode_key

# Set to true to bypass external API calls with mock data
NEURALFLIX_DEMO_MODE=false
