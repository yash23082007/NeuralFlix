# Docker Compose defaults to the bundled PostgreSQL and Redis services.
# Override DATABASE_URL only when using an external PostgreSQL database.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/neuralflix
REDIS_URL=redis://redis:6379/0

# Generate a unique secret before deploying (for example: python -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET=replace-this-with-a-long-random-secret

# Optional movie metadata providers. Core catalog browsing works without them.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
OMDB_API_KEY=

# Include the public frontend origin when deploying outside localhost.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
